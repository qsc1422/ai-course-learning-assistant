# 数据层：不填则使用嵌入式 PGlite（本地文件 .data/pg），填了则连接真实 PostgreSQL
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ke_ban

# PGlite 数据目录（可选）
# PGLITE_DATA_DIR=.data/pg

# 文件存储目录（可选，默认 .data/storage）
# STORAGE_DIR=.data/storage

# 大模型：OpenAI 兼容接口。不填则使用内置本地规则引擎，界面会明确标注。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# 向量化：不填则使用本地确定性向量；填了则调用 Ollama bge-m3
# OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=bge-m3
